# Trading mode: paper (simulated) or notify (signal-only with manual tracking)
TRADING_MODE=paper

# Market filtering
TICKER_SUFFIX=.MI
TARGET_COUNTRY=italy
COUNTRY_FILTER_STRICT=true
ETF_ITALY_KEYWORDS="FTSE MIB, Italy, BTP"

# Yahoo Finance fallback for missing bid/ask quotes
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_CACHE_SECONDS=60

# yfinance rate limiting and proxy settings
YF_RATE_LIMIT_ENABLED=true
YF_RATE_LIMIT_MAX_REQUESTS=30
YF_RATE_LIMIT_WINDOW_SECONDS=60
# Global HTTP proxy settings (used for yfinance, Borsa Italiana, and all external HTTP requests)
HTTP_PROXY_ENABLED=false
HTTP_PROXIES=[]
# Example proxies: HTTP_PROXIES=["http://user:pass@host1:port1","http://user:pass@host2:port2"]

# Order fill timeout
ORDER_FILL_TIMEOUT_SECONDS=60

# Maximum time (seconds) a queued limit order is allowed to stay open.
QUEUED_ORDER_TIMEOUT_SECONDS=900

# Maximum allowed distance of a limit price from the current best bid/ask (0.05 = 5%).
# Set to 0.0 to disable the check. The LLM can override this value dynamically.
LIMIT_PRICE_MAX_DISTANCE_PCT=0.05

# Minimum viable trade amount in base currency (default 500.0)
# Ensures round-trip fees are a reasonable percentage of trade value.
# With Intesa Sanpaolo fees, a 500 EUR trade has ~2.5% round-trip fees.
# The LLM can override this dynamically via "min_viable_trade_amount" in its JSON response.
MIN_VIABLE_TRADE_AMOUNT=500.0

# Hard maximum unrealized loss percentage (0.15 = 15%) that forces immediate exit
# regardless of LLM stop-loss review decisions.
HARD_MAX_LOSS_PCT=0.15

# BTP-specific hard max loss (0.05 = 5%) — BTPs are lower volatility than stocks
BTP_HARD_MAX_LOSS_PCT=0.05

# BTP-specific maximum take-profit percentage (0.03 = 3%) — BTPs trade in
# narrow ranges, so take-profit targets should be much smaller than stocks.
BTP_MAX_TAKE_PROFIT_PCT=0.03

# Maximum LLM stop-loss reviews before force-selling
MAX_STOP_LOSS_REVIEWS=10

# Maximum LLM take-profit reviews before force-selling
MAX_TAKE_PROFIT_REVIEWS=10

# Maximum LLM stop-loss reviews for long-term timeframes (>= 1 month, default 5)
LONG_TERM_MAX_STOP_LOSS_REVIEWS=5

# Maximum LLM stop-loss reviews for weekly timeframes (>= 1 week, < 1 month, default 7)
WEEKLY_MAX_STOP_LOSS_REVIEWS=7

# Timeframe threshold (seconds) for reducing max stop-loss reviews (2592000 = 30 days)
LONG_TERM_TF_SECONDS=2592000

# Base currency (e.g., EUR)
BASE_CURRENCY=EUR

ENFORCE_MIN_PROFIT_PER_TRADE=False

# Maximum number of symbols to trade simultaneously (default 10)
MAX_SYMBOLS=10

# Minimum number of symbols the LLM must select (when not pausing).
# Set to 0 to let the LLM decide freely. (default 3)
MIN_SYMBOLS=3

# Symbol selection limits
SYMBOL_SELECTION_MIN_SENTIMENT=-1.0
FALLBACK_MIN_24H_VOLUME=0.0
EXCLUDED_SYMBOLS=[]
# Additional base tickers (without suffix) to always include in discovery
# ADDITIONAL_TICKERS=["ISP","UCG","RACE"]

# Enable FinanceDatabase ticker discovery
FINANCEDATABASE_TICKER_DISCOVERY_ENABLED=true

# News-driven symbol discovery
NEWS_SYMBOL_DISCOVERY_ENABLED=false
NEWS_SYMBOL_DISCOVERY_MAX_SYMBOLS=5
NEWS_SYMBOL_DISCOVERY_MIN_SENTIMENT=0.3
NEWS_SYMBOL_DISCOVERY_MIN_ARTICLES=3

# RSS-based ticker discovery (scan RSS feeds for symbols with TICKER_SUFFIX)
NEWS_TICKER_DISCOVERY_ENABLED=true
NEWS_TICKER_DISCOVERY_MAX_SYMBOLS=10

# Paper trading initial balance (only used in paper mode)
PAPER_INITIAL_BALANCE=3000.0

# Cooldown between entry-signal forced LLM evaluations (seconds)
ENTRY_SIGNAL_COOLDOWN_SECONDS=30

# Minimum entry condition timeout as a multiple of the candle timeframe (default 2.0)
ENTRY_CONDITION_MIN_TIMEOUT_MULT=2.0

# Strategy evaluation interval multiplier (medium/long-term)
# 1 = evaluate every candle period (1w → weekly, 1M → monthly).
STRATEGY_INTERVAL_MULTIPLIER=1

# Active period settings – during these windows, the bot evaluates more frequently
# to catch opening/closing opportunities.
MARKET_OPEN_ACTIVE_MINUTES=60
MARKET_CLOSE_ACTIVE_MINUTES=30
ACTIVE_PERIOD_INTERVAL_SECONDS=900

# OHLCV timeframes for multi-timeframe analysis (primary: 1w, 1M; secondary: 1d)
OHLCV_TIMEFRAMES=["5Y", "3Y", "1Y", "6M", "3M", "1M", "1w", "1d", "1h"]

# Market data download interval (seconds)
MARKET_DATA_REFRESH_SECONDS=900

# Background quote refresh interval (seconds) – how often to fetch quotes
# for all tradable assets to keep Redis and the database warm.
# 900 seconds (15 minutes) is suitable for medium/long-term trading.
QUOTE_REFRESH_INTERVAL_SECONDS=900

# Entry signal monitor interval (seconds) – how often to scan for entry signals.
ENTRY_SIGNAL_CHECK_INTERVAL_SECONDS=900

# LLM Provider: "ollama" or "openai"
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=["deepseek-v4-flash"]
# OLLAMA_API_KEY=             # leave empty if not needed

# OpenAI-compatible API settings (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=["gpt-4o"]

# Mind model (complex reasoning) - used for coin selection and strategy generation
# OLLAMA_MIND_MODEL=["deepseek-v4-flash"]
OPENAI_MIND_MODEL=["gpt-4o"]

# Actuator model (fast operations) - used for critical decisions (stop-loss, take-profit, etc.)
# OLLAMA_ACTUATOR_MODEL=["deepseek-v4-flash"]
OPENAI_ACTUATOR_MODEL=["gpt-4o-mini"]

# Weak model (minor tasks: summarization, etc.) - used to save tokens on mind/actuator models
# Default to OpenAI API using OpenRouter free endpoint, with Ollama fallback
LLM_WEAK_PROVIDER=openai
OPENAI_WEAK_MODEL=["openrouter/free"]
OPENAI_WEAK_API_KEY=
OPENAI_WEAK_BASE_URL=https://openrouter.ai/api/v1

# Per-role Ollama settings for weak model (used as fallback if OpenAI fails)
OLLAMA_WEAK_MODEL=["gpt-oss:20b-cloud"]
# OLLAMA_WEAK_BASE_URL=http://localhost:11434
# OLLAMA_WEAK_API_KEY=

# Per-role temperature override for weak model (optional)
LLM_WEAK_TEMPERATURE=0.1

# Max input tokens for main models
OPENAI_MIND_MAX_INPUT_TOKENS=1000000
OPENAI_ACTUATOR_MAX_INPUT_TOKENS=1000000
OPENAI_WEAK_MAX_INPUT_TOKENS=128000
OLLAMA_MIND_MAX_INPUT_TOKENS=1000000
OLLAMA_ACTUATOR_MAX_INPUT_TOKENS=1000000
OLLAMA_WEAK_MAX_INPUT_TOKENS=128000

# Max input tokens for fallback models
OPENAI_MIND_FALLBACK_MAX_INPUT_TOKENS=16384
OPENAI_ACTUATOR_FALLBACK_MAX_INPUT_TOKENS=16384
OPENAI_WEAK_FALLBACK_MAX_INPUT_TOKENS=8192
OLLAMA_MIND_FALLBACK_MAX_INPUT_TOKENS=16384
OLLAMA_ACTUATOR_FALLBACK_MAX_INPUT_TOKENS=16384
OLLAMA_WEAK_FALLBACK_MAX_INPUT_TOKENS=8192

# Per‑role provider overrides (empty = use global LLM_PROVIDER)
# This allows the mind and actuator to use completely different providers.
# For example, mind=openai with a powerful model, actuator=ollama with a fast local model.
# LLM_MIND_PROVIDER=openai
# LLM_ACTUATOR_PROVIDER=ollama

# Per‑role OpenAI settings (empty = use global OPENAI_*)
# OPENAI_MIND_API_KEY=sk-...
# OPENAI_ACTUATOR_API_KEY=sk-...
# OPENAI_MIND_BASE_URL=https://api.openai.com/v1
# OPENAI_ACTUATOR_BASE_URL=https://api.openai.com/v1

# Per‑role Ollama settings (empty = use global OLLAMA_*)
# OLLAMA_MIND_BASE_URL=http://localhost:11434
# OLLAMA_ACTUATOR_BASE_URL=http://localhost:11434
# OLLAMA_MIND_API_KEY=
# OLLAMA_ACTUATOR_API_KEY=

# LLM temperature (0.0–2.0, lower = more deterministic; default 0.1)
LLM_TEMPERATURE=0.1

# LLM timeout in seconds for HTTP requests (default 300)
LLM_TIMEOUT=300

# Per‑role temperature overrides (optional).
# Can be a single float (e.g. 0.2) or a range "min-max" (e.g. "0.2-0.5").
# If a range is given, the engine picks a temperature inside it based on
# prompt complexity (higher complexity → higher temperature).
# If not set, the global LLM_TEMPERATURE is used.
LLM_MIND_TEMPERATURE=0.2-0.5
LLM_ACTUATOR_TEMPERATURE=0.0-0.1

# Threshold for choosing the "mind" model tier over "actuator" (0.05 to 0.80).
# Lower values = more frequent use of the "mind" model (higher cost/quality).
LLM_MIND_MODEL_THRESHOLD=0.20

# Enable automatic fallback to the other LLM provider if the primary fails (default false)
LLM_FALLBACK_ENABLED=true

# --- Fallback Provider Settings ---
# Fallback provider if the primary fails (empty = no fallback)
LLM_FALLBACK_PROVIDER=
LLM_MIND_FALLBACK_PROVIDER=
LLM_ACTUATOR_FALLBACK_PROVIDER=
LLM_WEAK_FALLBACK_PROVIDER=

# OpenAI fallback settings (empty = use global OPENAI_FALLBACK_*)
# OPENAI_FALLBACK_MODEL=[]
# OPENAI_FALLBACK_BASE_URL=
# OPENAI_FALLBACK_API_KEY=

# OPENAI_MIND_FALLBACK_MODEL=[]
# OPENAI_MIND_FALLBACK_BASE_URL=
# OPENAI_MIND_FALLBACK_API_KEY=

# OPENAI_ACTUATOR_FALLBACK_MODEL=[]
# OPENAI_ACTUATOR_FALLBACK_BASE_URL=
# OPENAI_ACTUATOR_FALLBACK_API_KEY=

# OPENAI_WEAK_FALLBACK_MODEL=[]
# OPENAI_WEAK_FALLBACK_BASE_URL=
# OPENAI_WEAK_FALLBACK_API_KEY=

# Ollama fallback settings (empty = use global OLLAMA_FALLBACK_*)
# OLLAMA_FALLBACK_MODEL=[]
# OLLAMA_FALLBACK_BASE_URL=
# OLLAMA_FALLBACK_API_KEY=

# OLLAMA_MIND_FALLBACK_MODEL=[]
# OLLAMA_MIND_FALLBACK_BASE_URL=
# OLLAMA_MIND_FALLBACK_API_KEY=

# OLLAMA_ACTUATOR_FALLBACK_MODEL=[]
# OLLAMA_ACTUATOR_FALLBACK_BASE_URL=
# OLLAMA_ACTUATOR_FALLBACK_API_KEY=

# OLLAMA_WEAK_FALLBACK_MODEL=[]
# OLLAMA_WEAK_FALLBACK_BASE_URL=
# OLLAMA_WEAK_FALLBACK_API_KEY=

# G4F (gpt4free) settings
# Note: g4f dynamically manages providers and models from code, so model names are not configured here.
# G4F_BASE_URL=http://127.0.0.1:1337/v1
# G4F_API_KEY=
# Max input tokens for main models
G4F_MIND_MAX_INPUT_TOKENS=128000
G4F_ACTUATOR_MAX_INPUT_TOKENS=128000
G4F_WEAK_MAX_INPUT_TOKENS=64000

# Max input tokens for fallback models
G4F_MIND_FALLBACK_MAX_INPUT_TOKENS=16384
G4F_ACTUATOR_FALLBACK_MAX_INPUT_TOKENS=16384
G4F_WEAK_FALLBACK_MAX_INPUT_TOKENS=8192

# Prompt caching for DeepSeek (and other providers that support it)
LLM_PROMPT_CACHING_ENABLED=true
LLM_PROMPT_CACHING_PROVIDERS=["deepseek", "ollama", "openai"]
# Providers that support the cache_control field (e.g., Anthropic via OpenRouter)
# DeepSeek and OpenAI use automatic prefix caching and do NOT need this field.
LLM_PROMPT_CACHING_CONTROL_PROVIDERS=[]

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2

# News / Sentiment – set the API keys for the sources you want to use.
# Sources are enabled automatically when their required keys are provided.
NEWS_ENABLED=false
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trade-ledger/1.0
# Fast news refresh for currently tracked symbols (minutes)
NEWS_FAST_UPDATE_INTERVAL_MINUTES=15

NEWS_MAX_ARTICLES_PER_SYMBOL=5
NEWS_CACHE_TTL_SECONDS=900
NEWS_HTTP_TIMEOUT_SECONDS=30.0
NEWS_RETENTION_SECONDS=86400

# Facebook (Graph API)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_POST_LIMIT=5

# RSS Feeds (comma-separated list of feed URLs)
RSS_FEEDS=["https://feeds.finance.yahoo.com/rss/2.0/headline?s=^GSPC&region=US&lang=en-US","https://www.investing.com/rss/news.rss","https://www.cnbc.com/id/100003114/device/rss/rss.html","https://www.bloomberg.com/feeds/podcasts/etf_report.xml","https://www.borsaitaliana.it/borsa/notizie/rss.html","https://www.milanofinanza.it/rss","https://www.ilsole24ore.com/rss/finanza.xml","https://it.investing.com/webmaster-tools/rss","https://news.teleborsa.it/NewsFeed.ashx","https://news.teleborsa.it/NewsFeed.ashx?channel=energia","https://news.teleborsa.it/NewsFeed.ashx?channel=banche","https://www.ilsole24ore.com/rss"]

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=5

# Google News RSS (free, no API key)
GOOGLE_NEWS_MAX_ARTICLES=5

# StockTwits API
STOCKTWITS_MAX_POSTS=5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=           # optional, can be set via /start

# Web interface
WEB_HOST=0.0.0.0
WEB_PORT=8083
# Optional basic authentication for web dashboard (leave empty to disable)
# If both are set, the browser will prompt for a username and password.
WEB_USERNAME=
WEB_PASSWORD=

# Web rate limiting
WEB_RATE_LIMIT_REQUESTS=300
WEB_RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO

# Borsa Italiana BTP list URL
BTP_URL=https://www.borsaitaliana.it/borsa/obbligazioni/mot/btp/lista.html

# Borsa Italiana market code (e.g., XMIL for Borsa di Milano)
MARKET_CODE=XMIL

# Market hours (Rome time)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=0
MARKET_CLOSE_HOUR=17
MARKET_CLOSE_MINUTE=30
MARKET_TIMEZONE=Europe/Rome

# BTP Bond Fees (Intesa Sanpaolo Investo)
BTP_FEE_PERC=0.0024
BTP_MIN_FEE=3.50
BTP_IS_PRIMARY_ISSUANCE=False

# Standard Stock/ETF Fees (Intesa Sanpaolo Investo)
STOCK_FEE_PERC=0.0024
STOCK_FEE_MIN=3.50
STOCK_FEE_FIXED=2.50
TOBIN_TAX_RATE=0.0012

# PostgreSQL (optional – if all are set, the bot uses PostgreSQL instead of SQLite)
DB_HOST=
DB_PORT=5432
DB_NAME=trade_ledger
DB_USER=trade_ledger
DB_PASSWORD=

# Risk management check interval (seconds)
RISK_CHECK_INTERVAL_SECONDS=120

# Risk check interval for very long timeframes (>= 1 year)
RISK_CHECK_INTERVAL_VERY_LONG_TF_SECONDS=14400

# Main engine loop polling interval (seconds)
ENGINE_LOOP_INTERVAL_SECONDS=60

# Symbol re-evaluation interval (seconds)
SYMBOL_REEVALUATION_INTERVAL=43200

# Portfolio rebalance settings
PORTFOLIO_REBALANCE_ENABLED=true
PORTFOLIO_REBALANCE_INTERVAL_SECONDS=7776000

# Fallback strategy evaluation interval (seconds)
DEFAULT_STRATEGY_INTERVAL=3600

# Minimum symbol re-evaluation interval (seconds)
MIN_SYMBOL_REEVALUATION_INTERVAL=3600

# Maximum number of trades to keep in memory
MAX_TRADES_IN_MEMORY=1000

# Initial delay before first symbol evaluation (seconds)
INITIAL_EVALUATION_DELAY_SECONDS=15

# Benchmark symbol for relative strength and market trend
BENCHMARK_SYMBOL=FTSEMIB.MI

# Maximum number of simultaneously open positions
MAX_OPEN_POSITIONS=10

# Number of candidate symbols per LLM chunk call
LLM_CHUNK_SIZE=20

# ETFs that are always included in the candidate pool
ALWAYS_INCLUDE_ETFS=[]

# Minimum composite score for volume-based fallback
FALLBACK_MIN_COMPOSITE_SCORE=0.1

# Composite score weights for symbol selection
COMPOSITE_TREND_WEIGHT=0.6
COMPOSITE_SENTIMENT_WEIGHT=0.4

# Maximum consecutive "keep paused" decisions before force-resume
PAUSE_MAX_CONSECUTIVE_KEEP=3

# Global risk multiplier applied when force-resuming
PAUSE_FORCE_RESUME_RISK_MULTIPLIER=0.5

# Maximum account drawdown (%) at which force-resume is blocked
PAUSE_FORCE_RESUME_MAX_DRAWDOWN_PCT=15.0

# Minimum LLM pause duration (seconds)
MIN_LLM_PAUSE_DURATION=1800

# Timeframe-specific hard max loss overrides
HARD_MAX_LOSS_PCT_1H=0.10
HARD_MAX_LOSS_PCT_1D=0.12
HARD_MAX_LOSS_PCT_1W=0.15
HARD_MAX_LOSS_PCT_1M=0.20
HARD_MAX_LOSS_PCT_3M=0.25
HARD_MAX_LOSS_PCT_6M_1Y=0.30

# Timeframe-specific BTP hard max loss overrides
BTP_HARD_MAX_LOSS_PCT_1H=0.03
BTP_HARD_MAX_LOSS_PCT_1D=0.04
BTP_HARD_MAX_LOSS_PCT_1W=0.05
BTP_HARD_MAX_LOSS_PCT_1M=0.06
BTP_HARD_MAX_LOSS_PCT_3M=0.08
BTP_HARD_MAX_LOSS_PCT_6M_1Y=0.10

# Maximum consecutive partial take-profit reviews
MAX_PARTIAL_TP_REVIEWS=10

# Maximum consecutive dust sweep reviews
MAX_DUST_SWEEP_REVIEWS=10

# Maximum time (seconds) dust can be kept before auto-selling
DUST_KEEP_TIMEOUT_SECONDS=604800

# Maximum position age as a multiple of the original max_hold_time_seconds
MAX_POSITION_AGE_MULTIPLIER=2.0

# Minimum seconds between condition-triggered re-evaluations
TRIGGERED_REEVALUATION_COOLDOWN=1800

# Evaluation intervals per timeframe (seconds)
EVAL_INTERVAL_1H=900
EVAL_INTERVAL_1D=1800
EVAL_INTERVAL_1W=3600
EVAL_INTERVAL_1M=86400
EVAL_INTERVAL_3M=172800
EVAL_INTERVAL_6M_1Y=604800
EVAL_INTERVAL_DEFAULT=3600

# Maximum interval (seconds) to skip LLM evaluation
MAX_SKIP_INTERVAL_SECONDS=604800

# Maximum age (seconds) for a quote to be considered fresh
QUOTE_MAX_STALENESS_SECONDS=3600.0

# Full asset OHLCV download interval (seconds)
FULL_ASSET_OHLCV_DOWNLOAD_INTERVAL_SECONDS=21600

# Full asset news download interval (seconds)
FULL_ASSET_NEWS_DOWNLOAD_INTERVAL_SECONDS=10800

# OHLCV download staggering (delay between symbols)
OHLCV_DOWNLOAD_SYMBOL_DELAY_SECONDS=2.0

# Maximum number of OHLCV candles to insert in a single backfill call
BACKFILL_MAX_CANDLES_PER_CALL=5000

# Maximum number of OHLCV gaps to fill per cycle
MAX_GAPS_PER_CYCLE=20

# Maximum number of backtest variants per cycle
MAX_BACKTEST_VARIANTS=10

# Maximum number of concurrent backtest variants
MAX_CONCURRENT_BACKTESTS=8

# Number of days of OHLCV data to retain
OHLCV_RETENTION_DAYS=3650

# Alpha Vantage
ALPHAVANTAGE_ENABLED=false
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_RATE_LIMIT_PER_MIN=5

# IEX Cloud
IEX_ENABLED=false
IEX_API_KEY=

# LLM timeout (seconds) for time-critical actuator calls
LLM_ACTUATOR_TIMEOUT=60.0

# LLM timeout (seconds) for fallback model calls (default 600)
LLM_FALLBACK_TIMEOUT=600.0

# LLM cache time-to-live (seconds)
LLM_CACHE_TTL=1800

# Orphaned order timeout (seconds)
ORPHANED_ORDER_TIMEOUT_SECONDS=600.0

# Delay between symbol evaluations (seconds)
SYMBOL_EVALUATION_DELAY_SECONDS=1.0

# Minimum candles required for backtesting
BACKTEST_MIN_CANDLES=5

# Staleness notify threshold (seconds)
STALENESS_NOTIFY_THRESHOLD_SECONDS=3600

# Data directory for logs, database, etc.
DATA_DIR=data

# Database path (used if DATABASE_BACKEND is sqlite)
DATABASE_PATH=data/trading_bot.db

# Database backend ("sqlite" or "postgresql")
DATABASE_BACKEND=sqlite

# News update interval (minutes)
NEWS_UPDATE_INTERVAL_MINUTES=60

# Rate limiting for news providers
NEWS_RATE_LIMIT_ENABLED=true
NEWS_RATE_LIMIT_PER_SOURCE_SECONDS=1.0

# Entry signal MACD magnitude threshold as a multiple of ATR
ENTRY_SIGNAL_MACD_ATR_MULT=0.05

# News sentiment exit timeframe threshold (seconds)
NEWS_SENTIMENT_EXIT_TF_SECONDS=604800

# Walk-forward backtest candle threshold
WALK_FORWARD_CANDLE_THRESHOLD=100

# Partial fill volume cap (fraction of last minute's volume)
PARTIAL_FILL_VOLUME_CAP_PCT=0.1

# Model tier scoring thresholds
MODEL_TIER_RSI_EXTREME=30.0
MODEL_TIER_ADX_STRONG=25.0
MODEL_TIER_DRAWDOWN_PCT=10.0
MODEL_TIER_ATR_PERCENTILE_HIGH=80.0
MODEL_TIER_ATR_PERCENTILE_LOW=20.0
MODEL_TIER_BB_WIDTH_SQUEEZE=0.02
MODEL_TIER_BB_WIDTH_EXPANSION=0.08
MODEL_TIER_PORTFOLIO_EXPOSURE_HIGH=70.0
MODEL_TIER_PORTFOLIO_STOP_RISK_HIGH=8.0
MODEL_TIER_SENTIMENT_TREND_MAG=0.2
MODEL_TIER_VOLUME_TREND_HIGH=3.0
MODEL_TIER_CONSECUTIVE_LOSSES=3
MODEL_TIER_PE_HIGH=50.0
MODEL_TIER_STOCH_EXTREME=20.0
MODEL_TIER_MFI_EXTREME=20.0
MODEL_TIER_CCI_EXTREME=100.0
MODEL_TIER_WILLIAMS_R_EXTREME=20.0
MODEL_TIER_MARKET_BREADTH_EXTREME=80.0
MODEL_TIER_MACD_HIST_CHANGE=0.0001

# Banca d'Italia BCE comunicati scraping for BTP news
BANCA_D_ITALIA_BTP_NEWS_ENABLED=false

# Notification log control
NOTIFICATION_LOG_ENABLED=true

# Notification verbosity: "all", "errors_only", "trades_only", or "none"
NOTIFICATION_VERBOSITY=all

# Always-Online Locally hosted weak model (last resort fallback)
AOL_LLM_PROVIDER=
AOL_LLM_MODEL=[]
AOL_LLM_API_KEY=
AOL_BASE_URL=
AOL_MAX_INPUT_TOKENS=16384

# AOL timeout (seconds) for last-resort fallback calls
AOL_TIMEOUT=120.0

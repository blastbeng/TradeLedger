# Trading mode: paper (simulated) or notify (signal-only with manual tracking)
TRADING_MODE=paper

# Market filtering
TICKER_SUFFIX=.MI
TARGET_COUNTRY=italy
ETF_ITALY_KEYWORDS="FTSE MIB, Italy, BTP"

# Yahoo Finance fallback for missing bid/ask quotes
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_CACHE_SECONDS=60

# yfinance rate limiting and proxy settings
YF_RATE_LIMIT_ENABLED=true
YF_RATE_LIMIT_MAX_REQUESTS=30
YF_RATE_LIMIT_WINDOW_SECONDS=60
# Global HTTP proxy settings (used for yfinance, Borsa Italiana, and all external HTTP requests)
HTTP_PROXY_ENABLED=false
HTTP_PROXIES=[]
# Example proxies: HTTP_PROXIES=["http://user:pass@host1:port1","http://user:pass@host2:port2"]

# Order fill timeout
ORDER_FILL_TIMEOUT_SECONDS=60

# Maximum time (seconds) a queued limit order is allowed to stay open.
QUEUED_ORDER_TIMEOUT_SECONDS=900

# Maximum allowed distance of a limit price from the current best bid/ask (0.05 = 5%).
# Set to 0.0 to disable the check. The LLM can override this value dynamically.
LIMIT_PRICE_MAX_DISTANCE_PCT=0.05

# Minimum viable trade amount in base currency (default 500.0)
# Ensures round-trip fees are a reasonable percentage of trade value.
# With Intesa Sanpaolo fees, a 500 EUR trade has ~2.5% round-trip fees.
# The LLM can override this dynamically via "min_viable_trade_amount" in its JSON response.
MIN_VIABLE_TRADE_AMOUNT=500.0

# Base currency (e.g., EUR)
BASE_CURRENCY=EUR

ENFORCE_MIN_PROFIT_PER_TRADE=False

# Maximum number of symbols to trade simultaneously (default 10)
MAX_SYMBOLS=10

# Maximum number of candidate symbols to send to the LLM for stock selection
MAX_LLM_CANDIDATES=80

# Symbol selection limits
SYMBOL_SELECTION_MIN_SENTIMENT=-1.0   # -1.0 = disabled
FALLBACK_MIN_24H_VOLUME=0.0
EXCLUDED_SYMBOLS=[]
# Additional base tickers (without suffix) to always include in discovery
# ADDITIONAL_TICKERS=["ISP","UCG","RACE"]

# Enable FinanceDatabase ticker discovery
FINANCEDATABASE_TICKER_DISCOVERY_ENABLED=true

# News-driven symbol discovery
NEWS_SYMBOL_DISCOVERY_ENABLED=false
NEWS_SYMBOL_DISCOVERY_MAX_SYMBOLS=5
NEWS_SYMBOL_DISCOVERY_MIN_SENTIMENT=0.3
NEWS_SYMBOL_DISCOVERY_MIN_ARTICLES=3

# RSS-based ticker discovery (scan RSS feeds for symbols with TICKER_SUFFIX)
NEWS_TICKER_DISCOVERY_ENABLED=true
NEWS_TICKER_DISCOVERY_MAX_SYMBOLS=10

# Paper trading initial balance (only used in paper mode)
PAPER_INITIAL_BALANCE=3000.0

# Cooldown between entry-signal forced LLM evaluations (seconds)
ENTRY_SIGNAL_COOLDOWN_SECONDS=30

# Minimum entry condition timeout as a multiple of the candle timeframe (default 2.0)
ENTRY_CONDITION_MIN_TIMEOUT_MULT=2.0

# Strategy evaluation interval multiplier (medium/long-term)
# 1 = evaluate every candle period (1w → weekly, 1M → monthly).
STRATEGY_INTERVAL_MULTIPLIER=1

# Active period settings – during these windows, the bot evaluates more frequently
# to catch opening/closing opportunities.
MARKET_OPEN_ACTIVE_MINUTES=60
MARKET_CLOSE_ACTIVE_MINUTES=30
ACTIVE_PERIOD_INTERVAL_SECONDS=900

# OHLCV timeframes for multi-timeframe analysis (primary: 1w, 1M; secondary: 1d)
OHLCV_TIMEFRAMES=["5Y", "3Y", "1Y", "6M", "3M", "1M", "1w", "1d", "1h"]

# Market data download interval (seconds)
MARKET_DATA_REFRESH_SECONDS=900

# Background quote refresh interval (seconds) – how often to fetch quotes
# for all tradable assets to keep Redis and the database warm.
# 900 seconds (15 minutes) is suitable for medium/long-term trading.
QUOTE_REFRESH_INTERVAL_SECONDS=900

# Entry signal monitor interval (seconds) – how often to scan for entry signals.
ENTRY_SIGNAL_CHECK_INTERVAL_SECONDS=900

# LLM Provider: "ollama" or "openai"
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-v4-flash
# OLLAMA_API_KEY=             # leave empty if not needed

# OpenAI-compatible API settings (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Mind model (complex reasoning) - used for coin selection and strategy generation
# OLLAMA_MIND_MODEL=deepseek-v4-flash
OPENAI_MIND_MODEL=gpt-4o

# Actuator model (fast operations) - used for critical decisions (stop-loss, take-profit, etc.)
# OLLAMA_ACTUATOR_MODEL=deepseek-v4-flash
OPENAI_ACTUATOR_MODEL=gpt-4o-mini

# Per‑role provider overrides (empty = use global LLM_PROVIDER)
# This allows the mind and actuator to use completely different providers.
# For example, mind=openai with a powerful model, actuator=ollama with a fast local model.
# LLM_MIND_PROVIDER=openai
# LLM_ACTUATOR_PROVIDER=ollama

# Per‑role OpenAI settings (empty = use global OPENAI_*)
# OPENAI_MIND_API_KEY=sk-...
# OPENAI_ACTUATOR_API_KEY=sk-...
# OPENAI_MIND_BASE_URL=https://api.openai.com/v1
# OPENAI_ACTUATOR_BASE_URL=https://api.openai.com/v1

# Per‑role Ollama settings (empty = use global OLLAMA_*)
# OLLAMA_MIND_BASE_URL=http://localhost:11434
# OLLAMA_ACTUATOR_BASE_URL=http://localhost:11434
# OLLAMA_MIND_API_KEY=
# OLLAMA_ACTUATOR_API_KEY=

# LLM temperature (0.0–2.0, lower = more deterministic; default 0.1)
LLM_TEMPERATURE=0.1

# LLM timeout in seconds for HTTP requests (default 300)
LLM_TIMEOUT=300

# Per‑role temperature overrides (optional).
# Can be a single float (e.g. 0.2) or a range "min-max" (e.g. "0.2-0.5").
# If a range is given, the engine picks a temperature inside it based on
# prompt complexity (higher complexity → higher temperature).
# If not set, the global LLM_TEMPERATURE is used.
LLM_MIND_TEMPERATURE=0.2-0.5
LLM_ACTUATOR_TEMPERATURE=0.0-0.1

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# News / Sentiment – set the API keys for the sources you want to use.
# Sources are enabled automatically when their required keys are provided.
NEWS_ENABLED=false
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trade-ledger/1.0
# Fast news refresh for currently tracked symbols (minutes)
NEWS_FAST_UPDATE_INTERVAL_MINUTES=15

NEWS_MAX_ARTICLES_PER_SYMBOL=5
NEWS_CACHE_TTL_SECONDS=900
NEWS_HTTP_TIMEOUT_SECONDS=30.0
NEWS_RETENTION_SECONDS=86400

# Facebook (Graph API)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_POST_LIMIT=5

# RSS Feeds (comma-separated list of feed URLs)
RSS_FEEDS=["https://feeds.finance.yahoo.com/rss/2.0/headline?s=^GSPC&region=US&lang=en-US","https://www.investing.com/rss/news.rss","https://www.cnbc.com/id/100003114/device/rss/rss.html","https://www.bloomberg.com/feeds/podcasts/etf_report.xml","https://www.borsaitaliana.it/borsa/notizie/rss.html","https://www.milanofinanza.it/rss","https://www.ilsole24ore.com/rss/finanza.xml","https://it.investing.com/webmaster-tools/rss","https://news.teleborsa.it/NewsFeed.ashx","https://news.teleborsa.it/NewsFeed.ashx?channel=energia","https://news.teleborsa.it/NewsFeed.ashx?channel=banche","https://www.ilsole24ore.com/rss"]

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=5

# Google News RSS (free, no API key)
GOOGLE_NEWS_MAX_ARTICLES=5

# StockTwits API
STOCKTWITS_MAX_POSTS=5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=           # optional, can be set via /start

# Web interface
WEB_HOST=0.0.0.0
WEB_PORT=8083

# Logging
LOG_LEVEL=INFO

# Borsa Italiana BTP list URL
BTP_URL=https://www.borsaitaliana.it/borsa/obbligazioni/mot/btp/lista.html

# Borsa Italiana market code (e.g., XMIL for Borsa di Milano)
MARKET_CODE=XMIL

# BTP Bond Fees (Intesa Sanpaolo Investo)
BTP_FEE_PERC=0.0024
BTP_MIN_FEE=3.50
BTP_IS_PRIMARY_ISSUANCE=False

# PostgreSQL (optional – if all are set, the bot uses PostgreSQL instead of SQLite)
DB_HOST=
DB_PORT=5432
DB_NAME=trade_ledger
DB_USER=trade_ledger
DB_PASSWORD=
